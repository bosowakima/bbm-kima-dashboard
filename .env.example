# Salin berkas ini menjadi .env.local, lalu isi nilainya.
# Di Vercel, keempat nilai ini diisi pada Settings > Environment Variables.

# Supabase > Project Settings > Data API > Project URL
# Contoh: https://abcdefghijklmnop.supabase.co  (tanpa garis miring di akhir)
SUPABASE_URL=

# Supabase > Project Settings > API Keys
# Pakai "secret" key (awalan sb_secret_) atau "service_role" key pada tab Legacy.
# Kunci ini RAHASIA: jangan dibagikan dan jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi untuk masuk ke halaman Admin. Gunakan minimal 12 karakter.
ADMIN_PASSWORD=
